# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Runtime connection via PgBouncer (transaction mode)
DATABASE_URL=postgresql://postgres:password@pgbouncer:6432/katisha?sslmode=disable

# Direct Postgres connection used only by Prisma CLI migrations
DIRECT_DATABASE_URL=postgresql://postgres:password@db:5432/katisha?sslmode=disable
# Superuser connection for Prisma shadow DB (prisma migrate dev only)
SHADOW_DATABASE_URL=postgresql://katisha:password@db:5432/postgres

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ── ImmuDB ───────────────────────────────────────────────────────────────────
IMMUDB_HOST=immudb
IMMUDB_PORT=3322
# Always "immudb" — not "immuadmin" (immuadmin is a binary, not a login)
IMMUDB_USER=immudb
IMMUDB_PASSWORD=ChangeMe_Strong_Password
IMMUDB_DATABASE=defaultdb

# ── FDI Payment Gateway ───────────────────────────────────────────────────────
# Use https://api.fdi.rw for production or the sandbox URL for testing
FDI_BASE_URL=https://sandbox.fdi.rw
FDI_APP_ID=your-fdi-app-id
FDI_SECRET=your-fdi-secret
# Wallet ID from your FDI dashboard
FDI_WALLET_ID=your-fdi-wallet-uuid

# Channel IDs are fetched automatically from GET /rw/v3/channels at startup.
# Set these as overrides if autodiscovery fails or for local testing.
FDI_MTN_CHANNEL_ID=
FDI_AIRTEL_CHANNEL_ID=

# ── Webhook callback ─────────────────────────────────────────────────────────
# Public base URL where FDI can reach this service.
# The service appends /webhooks/payment/callback?provider=fdi at runtime.
PAYMENT_CALLBACK_BASE_URL=https://api.katisha.online

# ── Service ──────────────────────────────────────────────────────────────────
PAYMENT_SERVICE_PORT=8099

# Platform fee in basis points. 100 = 1%, 50 = 0.5%, 0 = no fee.
# Always rounds UP to Katisha's advantage (no decimals in RWF).
PLATFORM_FEE_BASIS_POINTS=100

# ── JWT (shared with user service — not used directly by payment service) ────
JWT_SECRET=shared-jwt-secret-here
